<div class="flex flex-col gap-1 min-w-0">
  <div class="flex gap-2 items-center">
    <input type="text" class="input input-sm w-full flex-1 font-mono"
           :class="{ 'input-error': !!patternError('{{name}}') }"
           x-model="values['{{name}}']"
           placeholder="{{defaultDisplay}}"
           aria-label="{{label}}"
           :aria-invalid="!!patternError('{{name}}')">
    <template x-if="resolveHelper('{{name}}')">
      <button type="button" class="btn btn-soft btn-primary btn-sm shrink-0"
              @click="runHelper('{{name}}')"
              :disabled="helperBusy"
              x-text="resolveHelper('{{name}}').label"></button>
    </template>
  </div>
  {{#if (eq type.kind "strMatching")}}
    <p class="text-xs text-error leading-snug" x-cloak x-show="!!patternError('{{name}}')"
       x-text="patternError('{{name}}')"></p>
    <p class="text-[10px] text-base-content/45 font-mono leading-snug break-all"
       x-show="!patternError('{{name}}')">
      {{#if type.pattern}}Must match /{{type.pattern}}/{{else}}Constrained string{{/if}}
    </p>
  {{/if}}
</div>
